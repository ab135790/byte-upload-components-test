{
  "name": "byte-upload-components-test",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "lib/rollup/cjs/index.cjs",
  "module": "lib/rollup/es/index.js",
  "types": "lib/rollup/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/rollup/types/index.d.ts",
      "import": "./lib/rollup/es/index.js",
      "require": "./lib/rollup/cjs/index.cjs"
    },
    "./style.css": "./lib/rollup/es/index.css"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "r-build": "vue-tsc --project tsconfig.rollup.json --declaration --emitDeclarationOnly --declarationDir lib/rollup/types-temp && rollup -c",
    "prepublishOnly": "npm run r-build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "rollup-plugin-vue": "^6.0.0",
    "tslib": "^2.9.1",
    "typescript": "5.7.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
